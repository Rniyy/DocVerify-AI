# Used by docker-compose.yml. Copy to .env (same folder as docker-compose.yml)
# and fill in real values before running `docker compose up`.
# Never commit the real .env — this is just the template.

MYSQL_ROOT_PASSWORD=rootpassword
DB_PASSWORD=changeme
JWT_SECRET=change_this_to_a_long_random_string_in_production
ANTHROPIC_API_KEY=your_key_here

# Optional ------------------------------------------------------------
# Model used for AI comparison/explanations/extraction (python-service).
# ANTHROPIC_MODEL=claude-sonnet-5
# Comma-separated browser origins allowed to call the API. Unset = any origin
# (fine locally; set it before deploying), e.g. http://localhost:8080
# CORS_ORIGIN=http://localhost:8080
# Tesseract language(s) for scanned documents (Stage 26). Only English is
# installed in the Docker image; add language packs to python-service/Dockerfile
# (e.g. tesseract-ocr-khm) before listing more, e.g. eng+khm.
# OCR_LANGS=eng
